# Clustrix Auto-Updater Environment Variables

# ==================================================
# VERCEL API CONFIGURATION
# ==================================================
# The URL of your deployed Vercel API (for the Electron app to call)
UPDATE_API_URL=https://your-app.vercel.app/api

# ==================================================
# MONGODB CONFIGURATION
# ==================================================
# MongoDB connection string (used by Vercel API)
# Get this from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net

# MongoDB database name
MONGODB_DB_NAME=clustrix

# ==================================================
# GITHUB CONFIGURATION
# ==================================================
# GitHub Personal Access Token for accessing private releases
# Required permissions:
#   - Fine-grained token: Contents (Read and write)
#   - Classic token: repo (Full control of private repositories)
# Create token at: https://github.com/settings/tokens
GH_TOKEN=ghp_your_github_personal_access_token_here

# GitHub repository owner (username or organization)
GITHUB_REPO_OWNER=maszaen

# GitHub repository name
GITHUB_REPO_NAME=clustrix-ai-platform

# ==================================================
# DEPLOYMENT NOTES
# ==================================================
#
# FOR VERCEL DEPLOYMENT:
# 1. Go to: https://vercel.com/new
# 2. Import your GitHub repository
# 3. Add environment variables in Vercel dashboard:
#    - MONGODB_URI
#    - MONGODB_DB_NAME
#    - GH_TOKEN
#    - GITHUB_REPO_OWNER
#    - GITHUB_REPO_NAME
#
# FOR LOCAL ELECTRON APP:
# 1. Copy this file to .env (do NOT commit .env!)
# 2. Update UPDATE_API_URL with your deployed Vercel URL
# 3. GH_TOKEN is only needed for building/publishing releases
#
