# Clustrix Environment Variables
# Copy this file to .env and fill in the values

# Debug mode (true/false)
CLUSTRIX_DEBUG=false

# GitHub OAuth Configuration
# Required for GitHub sync/backup features
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:2920/oauth/callback

# API Keys for AI Providers
# You can set one or more of these depending on which providers you use

# OpenRouter API Key (recommended for multi-model support)
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq API Key
GROQ_API_KEY=your_groq_key_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_key_here

# OpenAI or Z.AI API Key (fallback)
OPENAI_API_KEY=your_openai_key_here
Z_API_KEY=your_z_api_key_here

# Base URL for custom API endpoints (if using custom provider)
BASE_URL=https://api.openai.com/v1

# Search API Configuration
# Used for web search functionality
SERPAPI_API_KEY=your_serpapi_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here
