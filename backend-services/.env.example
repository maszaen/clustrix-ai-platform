# Server
PORT=8080
NODE_ENV=development

# Admin Secret (untuk akses admin panel - GANTI INI!)
ADMIN_SECRET=your-super-secret-admin-key-change-this

# Firebase (untuk verify Google ID tokens)
# Download service account JSON dari Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Rate Limits (per user per day)
RATE_LIMIT_FREE=50
RATE_LIMIT_PREMIUM=1000

# ===========================================
# AI Provider API Keys (JANGAN SHARE KE PUBLIC!)
# ===========================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Mistral - https://console.mistral.ai/
MISTRAL_API_KEY=...

# Groq (Fast inference) - https://console.groq.com/
GROQ_API_KEY=gsk_...

# OpenRouter (Aggregator) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# xAI Grok - https://console.x.ai/
XAI_API_KEY=xai-...

# Zhipu AI (GLM) - https://open.bigmodel.cn/
ZHIPU_API_KEY=...

# BigModel - https://open.bigmodel.cn/ (same as Zhipu)
BIGMODEL_API_KEY=...

# Perplexity - https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Cerebras - https://inference.cerebras.ai/
CEREBRAS_API_KEY=...

# MegaLLM (Third-party proxy)
MEGALLM_API_KEY=...

# ===========================================
# Search APIs (untuk Agentic Mode)
# ===========================================
TAVILY_API_KEY=tvly-...
SERPAPI_API_KEY=...
