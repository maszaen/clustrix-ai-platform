# EAS Build ignore file
# Same as .gitignore but explicitly keeps local_modules

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# NOTE: local_modules is NOT ignored - we need it for build
# NOTE: dist/ is NOT ignored here - we need local_modules/*/dist/
