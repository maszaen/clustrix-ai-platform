{
  "name": "clustrix",
  "version": "28.6.0",
  "private": true,
  "description": "Clustrix - A smart AI chat assistant.",
  "author": "Maszaen Corporation",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "make": "npm run copy-env && electron-builder",
    "package": "npm run copy-env && electron-builder --dir",
    "publish": "npm run copy-env && electron-builder --publish=always",
    "copy-env": "node -e \"const fs = require('fs'); const path = require('path'); const src = path.join(__dirname, '.env'); const dest = path.join(__dirname, 'out', '.env'); if (fs.existsSync(src)) { const data = fs.readFileSync(src); fs.mkdirSync(path.dirname(dest), { recursive: true }); fs.writeFileSync(dest, data); console.log('✓ Copied .env to out/'); } else { console.log('⚠ .env file not found (optional)'); }\"",
    "node": "cross-env BASE_URL=https://api.z.ai/api/paas/v4/ Z_API_KEY=b7f88f50fbeb465b8318ae2270473c80.rWD9EyijW0zniHA1 npm run start"
  },
  "build": {
    "appId": "com.zaen.clustrix",
    "productName": "Clustrix",
    "directories": {
      "output": "out"
    },
    "files": [
      "*",
      "**/*",
      "node_modules/**/*",
      "!\\.git/**",
      "!README.md",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "public/images/favicon.ico",
      "installerHeaderIcon": "public/images/favicon.ico",
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/jest": "^30.0.0",
    "cross-env": "^7.0.3",
    "electron": "^38.1.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.14",
    "@langchain/textsplitters": "^0.1.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.4.1",
    "googleapis": "^164.0.0",
    "langchain": "^0.3.35",
    "mammoth": "^1.10.0",
    "mathjax": "^4.0.0",
    "open": "^10.2.0",
    "serpapi": "^2.2.1",
    "uuid": "^10.0.0"
  }
}
