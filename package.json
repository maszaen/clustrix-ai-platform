{
  "name": "clustrix",
  "version": "26.2.0",
  "private": true,
  "description": "Clustrix - A smart AI chat assistant.",
  "author": "Zaen",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "make": "electron-builder",
    "package": "electron-builder --dir",
    "publish": "electron-builder --publish=always",
    "node": "cross-env BASE_URL=https://api.z.ai/api/paas/v4/ Z_API_KEY=b7f88f50fbeb465b8318ae2270473c80.rWD9EyijW0zniHA1 npm run start"
  },
  "build": {
    "appId": "com.zaen.clustrix",
    "productName": "Clustrix",
    "directories": {
      "output": "out"
    },
    "files": [
      "**/*",
      "!out/**",
      "!\\.git/**",
      "!README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "public/images/favicon.ico",
      "installerHeaderIcon": "public/images/favicon.ico",
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3",
    "electron": "^38.1.0"
  },
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@mathjax/mathjax-newcm-font": "^4.0.0",
    "cheerio": "^1.1.2",
    "highlight.js": "^11.11.1",
    "langchain": "^0.3.0",
    "mammoth": "^1.10.0",
    "mathjax": "^4.0.0",
    "perfect-scrollbar": "^1.5.6",
    "serpapi": "^2.2.1",
    "uuid": "^10.0.0",
    "xlsx": "file:./local_modules/xlsx"
  }
}
