{
  "name": "clustrix",
  "version": "35.4.0",
  "private": true,
  "description": "Clustrix - A smart AI chat assistant.",
  "author": "Maszaen Corporation",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:codes": "jest backend/codes/__tests__",
    "test:codes:watch": "jest backend/codes/__tests__ --watch",
    "test:coverage": "jest --coverage",
    "make": "electron-builder",
    "package": "electron-builder --dir",
    "publish": "electron-builder --publish=always"
  },
  "build": {
    "appId": "com.zaen.clustrix",
    "productName": "Clustrix",
    "directories": {
      "output": "out"
    },
    "files": [
      "*",
      "**/*",
      "node_modules/**/*",
      "resources/**/*",
      "!\\.git/**",
      "!README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "public/images/favicon.ico",
      "installerHeaderIcon": "public/images/favicon.ico",
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maszaen",
        "repo": "clustrix-ai-platform",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/jest": "^30.0.0",
    "cross-env": "^7.0.3",
    "electron": "^38.3.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.14",
    "@langchain/textsplitters": "^0.1.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "google-auth-library": "^10.4.1",
    "googleapis": "^164.0.0",
    "langchain": "^0.3.35",
    "mammoth": "^1.10.0",
    "mathjax": "^4.0.0",
    "mermaid": "^11.12.0",
    "open": "^10.2.0",
    "pdf-parse": "^2.4.5",
    "serpapi": "^2.2.1",
    "uuid": "^10.0.0"
  }
}
